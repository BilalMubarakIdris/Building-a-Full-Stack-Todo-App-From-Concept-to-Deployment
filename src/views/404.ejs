<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found - Todo App</title>
    <link rel="stylesheet" href="/css/style.css" />
    <style>
      .error-container {
        text-align: center;
        padding: 4rem 2rem;
        min-height: 60vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }
      .error-code {
        font-size: 6rem;
        font-weight: bold;
        color: #4361ee;
        margin-bottom: 1rem;
      }
      .error-message {
        font-size: 1.5rem;
        margin-bottom: 2rem;
        color: #333;
      }
      .btn {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: #4361ee;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 500;
      }
      .btn:hover {
        background: #3a0ca3;
      }
    </style>
  </head>
  <body>
    <%- include('layouts/main.ejs', { title: 'Page Not Found' }) %>

    <div class="error-container">
      <div class="error-code">404</div>
      <div class="error-message">
        Oops! The page you're looking for doesn't exist.
      </div>
      <a href="/" class="btn">Go Home</a>
    </div>
  </body>
</html>
